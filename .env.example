# ==========================================
# Crypto Trading AI Toolkit - Configuración
# ==========================================
# Copia este archivo a .env y completa con tus valores

# 🔐 CREDENCIALES BINANCE (opcional, solo para mainnet)
# BINANCE_API_KEY=tu_clave_aqui
# BINANCE_API_SECRET=tu_secreto_aqui

# 🔐 CREDENCIALES OKX (opcional, solo para mainnet)
# OKX_API_KEY=tu_clave_aqui
# OKX_SECRET_KEY=tu_secreto_aqui
# OKX_PASSPHRASE=tu_passphrase_aqui

# ⚙️  CONFIGURACIÓN DEL BOT
BOT_EXCHANGE=binance           # binance o okx
BOT_SANDBOX=True              # True para testnet, False para mainnet
BOT_DEFAULT_RISK_PCT=1.0      # Porcentaje de riesgo por trade
BOT_MIN_CONFIDENCE=0.5        # Confianza mínima para ejecutar trades

# 🤖 CONFIGURACIÓN CEREBRO RL
CEREBRO_DEVICE=cpu            # cpu o cuda (si tienes GPU)
CEREBRO_MIN_PROB=0.5          # Probabilidad mínima para decisión
CEREBRO_ENABLED=True          # Habilitar/deshabilitar Cerebro RL

# 📊 DATOS Y LOGS
DATA_DIR=./data               # Directorio de datos
LOGS_DIR=./logs               # Directorio de logs
LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR

# 📈 BACKTESTING
BACKTEST_START_BALANCE=10000  # Balance inicial
BACKTEST_SYMBOLS=BTC/USDT,ETH/USDT  # Símbolos a probar
BACKTEST_TIMEFRAME=5m         # 5m, 15m, 1h, 4h, 1d

# 🔔 NOTIFICACIONES (opcional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=tu_token_aqui
# TELEGRAM_CHAT_ID=tu_chat_id_aqui

# 🌐 PROXY (si lo necesitas)
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
